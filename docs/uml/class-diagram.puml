@startuml class-diagram
title SmartMart: class diagram v1 (auth, inventory, purchasing and POS domain)
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

' Domain classes built so far, in the auth, inventory, purchasing and pos
' domain packages, plus the store settings in common.config. Every entity
' also has createdAt and updatedAt (Instant), left out here to keep the
' diagram readable. The design patterns of GUIDELINES.md section 5 that are
' in use are shown as notes: Player-Role, General Hierarchy and
' Abstraction-Occurrence (5.11), Singleton (5.4), Strategy (5.1),
' Memento (5.9), Facade (5.5) and State (5.6). The pos.service package shows only the
' checkout classes that play a pattern role.

package "auth.domain" {

  class User <<Entity>> <<Player>> {
    - id : Long
    - username : String
    - fullName : String
    - passwordHash : String
    - active : boolean
    + roleNames() : Set<RoleName>
    + update(username, fullName, roles) : void
    + changePassword(passwordHash) : void
    + deactivate() : void
  }

  class Role <<Entity>> <<Role>> {
    - id : Long
    - name : RoleName
  }

  enum RoleName {
    ADMIN
    MANAGER
    CASHIER
    INVENTORY_STAFF
  }

  User "0..*" o--> "1..*" Role : holds >
  Role --> "1" RoleName

  note "Player–Role\nA User (player) holds one or more Roles.\nRoles are objects, not subclasses of User,\nso a user's roles change without changing class." as N_PR
  N_PR .. User
  N_PR .. Role
}

package "inventory.domain" {

  class Category <<Entity>> {
    - id : Long
    - name : String
    + rename(newName) : void
    + moveUnder(newParent) : void
  }

  class Product <<Entity>> <<Abstraction>> {
    - id : Long
    - name : String
    - barcode : String
    - saleUnit : SaleUnit
    - price : BigDecimal
    - lowStockThreshold : BigDecimal [0..1]
    - active : boolean
    + update(...) : void
    + isLowOnStock(totalStock, storeDefault) : boolean
  }

  class StockBatch <<Entity>> <<Occurrence>> {
    - id : Long
    - batchNumber : String
    - quantity : BigDecimal
    - cost : BigDecimal
    - expiryDate : LocalDate [0..1]
    + take(wanted) : BigDecimal
  }

  enum SaleUnit {
    PIECE
    KG
    - maxDecimals : int
    + allows(quantity) : boolean
  }

  Category "0..*" --> "0..1" Category : parent >
  Product "0..*" --> "1" Category : category >
  StockBatch "0..*" --> "1" Product : product >
  Product --> "1" SaleUnit

  note "General Hierarchy\nA Category has an optional parent Category,\nforming a tree: Grocery → Rice → Miniket." as N_GH
  N_GH .. Category

  note "Abstraction–Occurrence\nProduct holds the shared data (name, barcode,\ncategory, price). Each StockBatch is one delivery\n(batch number, quantity, cost, expiry date).\nName and price are never copied into a batch." as N_AO
  N_AO .. Product
  N_AO .. StockBatch
}

package "purchasing.domain" {

  class Supplier <<Entity>> {
    - id : Long
    - name : String
    - contactPerson : String [0..1]
    - phone : String
    - email : String [0..1]
    - address : String [0..1]
    - active : boolean
    + update(name, contactPerson, phone, email, address, active)
  }

  class PurchaseOrder <<Context>> {
    - id : Long
    - status : PurchaseOrderStatus
    - note : String [0..1]
    - state : PurchaseOrderState {transient}
    + addLine(productId, quantity, unitCost)
    + submit()
    + receive(quantities : Map<Long, BigDecimal>)
    + cancel()
    + close()
    + getTotal() : BigDecimal
    ~ changeState(next : PurchaseOrderState)
    ~ recordDelivery(quantities : Map<Long, BigDecimal>)
  }

  class PurchaseOrderLine <<Entity>> {
    - id : Long
    - productId : Long
    - quantity : BigDecimal
    - unitCost : BigDecimal
    - receivedQuantity : BigDecimal
    + getOutstanding() : BigDecimal
    + getLineTotal() : BigDecimal
  }

  enum PurchaseOrderStatus {
    DRAFT
    SUBMITTED
    PARTIALLY_RECEIVED
    RECEIVED
    CLOSED
    CANCELLED
  }

  interface PurchaseOrderState <<State>> {
    + status() : PurchaseOrderStatus
    + submit(order)
    + receive(order, quantities)
    + cancel(order)
    + close(order)
    + {static} of(status) : PurchaseOrderState
  }

  class DraftState <<ConcreteState>>
  class SubmittedState <<ConcreteState>>
  class PartiallyReceivedState <<ConcreteState>>
  class ReceivedState <<ConcreteState>>
  class ClosedState <<ConcreteState>>
  class CancelledState <<ConcreteState>>

  Supplier "1" <-- "0..*" PurchaseOrder
  PurchaseOrder "1" *-- "1..*" PurchaseOrderLine
  PurchaseOrder --> "1" PurchaseOrderState : state
  PurchaseOrder --> PurchaseOrderStatus
  PurchaseOrderState <|.. DraftState
  PurchaseOrderState <|.. SubmittedState
  PurchaseOrderState <|.. PartiallyReceivedState
  PurchaseOrderState <|.. ReceivedState
  PurchaseOrderState <|.. ClosedState
  PurchaseOrderState <|.. CancelledState

  note "State\nPurchaseOrder (context) hands every action to its\ncurrent PurchaseOrderState. Each state allows only its\nactions (SRS FR-PUR-5 to 7); the interface's default\nmethods refuse the rest with IllegalStateTransitionException.\nThe status column is stored; of(status) rebuilds the state\nwhen an order is loaded (GUIDELINES.md 5.6)." as N_ST
  N_ST .. PurchaseOrderState
}

PurchaseOrderLine ..> Product : productId

package "pos.domain" {

  class Cart <<Originator>> {
    - lines : Map<Long, CartLine>
    - discountId : Long
    + add(line) : void
    + changeQuantity(productId, quantity) : void
    + remove(productId) : void
    + applyDiscount(discountId) : void
    + clear() : void
    + subtotal() : BigDecimal
    + snapshot() : CartSnapshot
    + restore(snapshot) : void
  }

  class CartLine <<Record>> {
    + productId : Long
    + productName : String
    + barcode : String
    + saleUnit : SaleUnit
    + unitPrice : BigDecimal
    + quantity : BigDecimal
    + total() : BigDecimal
  }

  class CartSnapshot <<Record>> <<Memento>> {
    + lines : List<CartLine>
    + discountId : Long
  }

  class CartHistory <<Caretaker>> {
    - snapshots : Deque<CartSnapshot>
    + push(snapshot) : void
    + pop() : Optional<CartSnapshot>
    + isEmpty() : boolean
    + clear() : void
  }

  interface DiscountStrategy <<Strategy>> {
    + discountOn(eligibleTotal) : BigDecimal
  }

  class PercentageDiscount <<Record>> {
    + percent : BigDecimal
  }

  class FlatAmountDiscount <<Record>> {
    + amount : BigDecimal
  }

  class Discount <<Entity>> {
    - id : Long
    - name : String
    - value : BigDecimal
    - startsOn : LocalDate
    - endsOn : LocalDate
    + strategy() : DiscountStrategy
  }

  enum DiscountType {
    PERCENTAGE
    FLAT
    + strategyFor(value) : DiscountStrategy
  }

  class Sale <<Entity>> {
    - id : Long
    - cashierId : Long
    - discountId : Long
    - soldAt : Instant
    - subtotal : BigDecimal
    - discountAmount : BigDecimal
    - total : BigDecimal
    - vatIncluded : BigDecimal
    + invoiceNumber() : String
  }

  class SaleLine <<Entity>> {
    - productId : Long
    - quantity : BigDecimal
    - unitPrice : BigDecimal
    - lineTotal : BigDecimal
  }

  class Payment <<Entity>> {
    - method : String
    - amount : BigDecimal
    - cashReceived : BigDecimal
    - changeDue : BigDecimal
  }

  Cart "1" *--> "0..*" CartLine : lines >
  Cart ..> CartSnapshot : creates and restores from >
  CartSnapshot "1" *--> "0..*" CartLine
  CartHistory "1" o--> "0..20" CartSnapshot : keeps >
  PercentageDiscount ..|> DiscountStrategy
  FlatAmountDiscount ..|> DiscountStrategy
  Discount --> "1" DiscountType : type >
  DiscountType ..> DiscountStrategy : builds >
  Sale "1" *--> "1..*" SaleLine : lines >
  Sale "1" *--> "1" Payment : payment >

  note "Memento\nCart (originator) saves its lines in an immutable\nCartSnapshot (memento) before each change.\nCartHistory (caretaker) keeps the last 20, so the\ncashier can undo one change at a time (FR-POS-4)." as N_MM
  N_MM .. Cart
  N_MM .. CartSnapshot
  N_MM .. CartHistory

  note "Strategy\nEach kind of discount is its own class, so a new\nkind is added without changing checkout code.\nA discount is never negative and never more\nthan the total it applies to (FR-POS-8)." as N_ST
  N_ST .. DiscountStrategy
}

CartLine --> "1" SaleUnit

package "pos.service" {

  interface CheckoutFacade <<Facade>> {
    + completeSale(cashierId, payment) : Long
  }

  interface PaymentMethod <<Strategy>> {
    + pay(amount, details) : PaymentResult
  }

  class CashPayment

  CashPayment ..|> PaymentMethod

  note "Facade\nThe payment page calls only completeSale. In one\ntransaction it reads the cart and discount, takes the\npayment, deducts stock first-expiry-first-out and saves\nthe sale (FR-POS-10). The cart is cleared after the commit." as N_FC
  N_FC .. CheckoutFacade

  note "Strategy\nCheckout pays through PaymentMethod without knowing\nthe method; cash is the only one in v1 (FR-POS-9)." as N_PM
  N_PM .. PaymentMethod
}

CheckoutFacade ..> PaymentMethod : pays with >
CheckoutFacade ..> Sale : saves >

package "common.config" {

  class StoreSettings <<Record>> <<Singleton>> {
    + lowStockDefault : BigDecimal
    + vatRate : BigDecimal
  }

  note "Singleton\nOne immutable Spring bean per application,\nread from application.yml at startup (GUIDELINES.md 5.4).\nThe product service passes lowStockDefault to\nProduct.isLowOnStock; the cart service uses vatRate." as N_SG
  N_SG .. StoreSettings
}

@enduml
