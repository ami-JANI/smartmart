@startuml erd
title SmartMart: entity relationship diagram v1 (auth, inventory, point of sale and purchasing)
skinparam shadowing false
skinparam linetype ortho
hide circle

' Tables created by the Liquibase changesets in
' src/main/resources/db/changelog/changes. PK = primary key, FK = foreign key,
' UQ = unique. Money is NUMERIC(12,2); quantities are NUMERIC(12,3).

package "User management" {

  entity users {
    * id : bigint <<PK>>
    --
    * username : varchar(50) <<UQ>>
    * full_name : varchar(100)
    * password_hash : varchar(100)
    * active : boolean = true
    * created_at : timestamptz
    * updated_at : timestamptz
  }

  entity roles {
    * id : bigint <<PK>>
    --
    * name : varchar(30) <<UQ>>
    * created_at : timestamptz
    * updated_at : timestamptz
  }

  entity user_roles {
    * user_id : bigint <<PK, FK>>
    * role_id : bigint <<PK, FK>>
    --
    * created_at : timestamptz
    * updated_at : timestamptz
  }
}

package "Inventory" {

  entity categories {
    * id : bigint <<PK>>
    --
    * name : varchar(100)
    parent_id : bigint <<FK>>
    * created_at : timestamptz
    * updated_at : timestamptz
    ..
    UQ (parent_id, name) NULLS NOT DISTINCT
  }

  entity products {
    * id : bigint <<PK>>
    --
    * name : varchar(120)
    * barcode : varchar(20) <<UQ>>
    * category_id : bigint <<FK>>
    * sale_unit : varchar(10)
    * price : numeric(12,2)
    low_stock_threshold : numeric(12,3)
    * active : boolean
    * created_at : timestamptz
    * updated_at : timestamptz
  }

  entity stock_batches {
    * id : bigint <<PK>>
    --
    * product_id : bigint <<FK>>
    * batch_number : varchar(50)
    * quantity : numeric(12,3)
    * cost : numeric(12,2)
    expiry_date : date
    * created_at : timestamptz
    * updated_at : timestamptz
    ..
    CHECK (quantity >= 0)
  }
}

package "Point of sale" {

  entity discounts {
    * id : bigint <<PK>>
    --
    * name : varchar(80) <<UQ>>
    * type : varchar(20)
    * value : numeric(12,2)
    * starts_on : date
    * ends_on : date
    * created_at : timestamptz
    * updated_at : timestamptz
    ..
    CHECK (type IN ('PERCENTAGE', 'FLAT'))
    CHECK (value > 0, and <= 100 for PERCENTAGE)
    CHECK (ends_on >= starts_on)
  }

  entity sales {
    * id : bigint <<PK>>
    --
    * cashier_id : bigint <<FK>>
    discount_id : bigint <<FK>>
    * sold_at : timestamptz
    * subtotal : numeric(12,2)
    * discount_amount : numeric(12,2)
    * total : numeric(12,2)
    * vat_included : numeric(12,2)
    * created_at : timestamptz
    * updated_at : timestamptz
    ..
    CHECK (total = subtotal - discount_amount)
  }

  entity sale_lines {
    * id : bigint <<PK>>
    --
    * sale_id : bigint <<FK>>
    * product_id : bigint <<FK>>
    * quantity : numeric(12,3)
    * unit_price : numeric(12,2)
    * line_total : numeric(12,2)
    * created_at : timestamptz
    * updated_at : timestamptz
  }

  entity payments {
    * id : bigint <<PK>>
    --
    * sale_id : bigint <<FK, UQ>>
    * method : varchar(20)
    * amount : numeric(12,2)
    * cash_received : numeric(12,2)
    * change_due : numeric(12,2)
    * created_at : timestamptz
    * updated_at : timestamptz
    ..
    CHECK (cash_received >= amount)
  }
}

package "Purchasing" {

  entity suppliers {
    * id : bigint <<PK>>
    --
    * name : varchar(120) <<UQ>>
    contact_person : varchar(100)
    * phone : varchar(20)
    email : varchar(120)
    address : varchar(255)
    * active : boolean
    * created_at : timestamptz
    * updated_at : timestamptz
  }

  entity purchase_orders {
    * id : bigint <<PK>>
    --
    * supplier_id : bigint <<FK>>
    * status : varchar(20)
    note : varchar(255)
    * created_at : timestamptz
    * updated_at : timestamptz
    ..
    CHECK (status IN (DRAFT, SUBMITTED,
      PARTIALLY_RECEIVED, RECEIVED, CLOSED, CANCELLED))
  }

  entity purchase_order_lines {
    * id : bigint <<PK>>
    --
    * purchase_order_id : bigint <<FK>>
    * product_id : bigint <<FK>>
    * quantity : numeric(12,3)
    * unit_cost : numeric(12,2)
    * received_quantity : numeric(12,3)
    * created_at : timestamptz
    * updated_at : timestamptz
    ..
    UNIQUE (purchase_order_id, product_id)
    CHECK (quantity > 0 AND unit_cost >= 0
      AND 0 <= received_quantity <= quantity)
  }
}

users ||--o{ user_roles
roles ||--o{ user_roles
categories |o--o{ categories : parent
categories ||--o{ products
products ||--o{ stock_batches
users ||--o{ sales : cashier
discounts |o--o{ sales
sales ||--|{ sale_lines
products ||--o{ sale_lines
sales ||--|| payments
suppliers ||--o{ purchase_orders
purchase_orders ||--|{ purchase_order_lines
products ||--o{ purchase_order_lines

note bottom of user_roles
  Deleting a user deletes its rows here.
  The roles table holds the four roles
  ADMIN, MANAGER, CASHIER, INVENTORY_STAFF.
end note

note bottom of sales
  A sale is also its invoice; the invoice
  number is formed from the id (INV-000042).
  Deleting a sale deletes its lines and payment.
end note

@enduml
