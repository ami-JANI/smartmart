# Copy to .env and set real values. Never commit .env.
DB_NAME=smartmart
DB_USER=smartmart
DB_PASSWORD=change-me
REPLICATION_USER=replicator
REPLICATION_PASSWORD=change-me-too

# First administrator, created when the application starts if the
# username does not exist yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# Sample shop data for trying the app: logins manager, cashier and stock
# (password smartmart-demo), products, stock, alerts and suppliers. Loaded
# once, on a fresh database. Delete the line for a clean, real-shop database.
LIQUIBASE_CONTEXTS=demo

# Used when the application runs on the host (./mvnw spring-boot:run or
# the tests). In Docker Compose, compose.yaml points the application at
# the db-primary and db-replica services instead.
DB_PRIMARY_URL=jdbc:postgresql://localhost:5432/smartmart
DB_REPLICA_URL=jdbc:postgresql://localhost:5433/smartmart

# Monitoring (README, "Monitoring"). Prometheus logs in to the application's
# /actuator/prometheus as "prometheus" with METRICS_PASSWORD; leave it empty to
# keep that endpoint closed. Grafana's login is admin / GRAFANA_ADMIN_PASSWORD.
# GRAFANA_URL is where the Monitoring link for administrators points.
METRICS_PASSWORD=change-me-metrics
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_URL=http://localhost:3000
